# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Raw data at repo root is ignored. The UCI dataset in notebooks/data/ is
# committed on purpose (CC BY 4.0) so the notebook runs offline.
data/*.xlsx
data/*.xls
data/*.csv

# Processed data — keep structure, ignore files
data/*.parquet
!data/.gitkeep

# Model files
results/models/*.pkl
!results/models/.gitkeep

# Commit plots and segment CSVs (needed for README display)
!results/plots/*.png
!results/segments/*.csv
!results/segments/*.json

# OS
.DS_Store
Thumbs.db